{
  "name": "erosion-sandbox",
  "version": "2.3.0",
  "private": true,
  "description": "Local conservative hydraulic-erosion sandbox",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/regression/production.test.js tests/regression/terrain-navigation.test.js tests/regression/scenes.test.js",
    "test:long": "node tests/regression/long-run.js",
    "test:baseline": "node tests/regression/physics-regression.js 1000",
    "test:legacy": "node tests/regression/legacy-integrity.js",
    "test:browser": "npm run build:offline && python tests/browser/scenes.py",
    "build": "node tools/build-standalone.js",
    "benchmark": "node tests/benchmarks/physics-profile.js 1000",
    "audit:legacy": "node tests/diagnostics/legacy-baseline-audit.js",
    "test:layout": "npm run build:offline && python tests/browser/scenes.py --layout",
    "test:terrain": "node --test tests/regression/terrain-navigation.test.js",
    "test:navigation": "npm run build:offline && python tests/browser/scenes.py",
    "test:scenes": "node --test tests/regression/scenes.test.js",
    "build:offline": "node tools/build-standalone.js --skip-icons",
    "audit:scenes": "node tests/diagnostics/scenes-audit.js --maps-only && node tests/diagnostics/scenes-audit.js --long-only"
  },
  "dependencies": {
    "lucide": "1.52.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
